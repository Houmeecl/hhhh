# ============================================================
# sicr3p — Etapa 1 · Variables de entorno (ejemplo)
# Copia este archivo a backend/.env y complétalo. NUNCA lo commitees.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=4000
# Origen permitido para CORS (frontend). En prod: https://app.sicr3p.cl
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend (usada en los QR de las etiquetas)
PUBLIC_APP_URL=http://localhost:5173

# --- Base de datos (Neon / PostgreSQL) ---
# En Neon: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://sicr3p:sicr3p_dev@localhost:5432/sicr3p

# --- Simple API (motor externo, SOLO backend) ---
# MODO MOCK: true = respuestas simuladas, no consume la API real.
# Paso a producción: poner MOCK_SIMPLE=false y una SIMPLE_API_KEY real.
MOCK_SIMPLE=true
SIMPLE_API_BASE=https://app.itssimple.com/public/v1
SIMPLE_API_KEY=

# Kill switch del motor externo. Con 'off' NINGÚN documento del cliente
# sale a un motor de terceros: lo que el motor propio no logra leer se
# rechaza (HTTP 422) y se pide re-escanear — nunca corrección manual.
# Apagarlo cuando el % de independencia del panel sea ~100 por varias
# semanas; ahí SIMPLE_API_KEY deja de ser necesaria.
MOTOR_EXTERNO=on

# --- Análisis de documentos con IA (Anthropic Claude) ---
# Camino PRINCIPAL de lectura de texto/OCR (más flexible que el parser de
# reglas ante layouts raros y ruido de OCR); si no hay clave, la llamada
# falla, o la respuesta no valida, cae AUTOMÁTICAMENTE al parser de reglas
# — nunca se rechaza un documento solo porque la IA no respondió. La IA
# SOLO extrae y clasifica (folio, RUTs, ítems, tipo de documento): el
# cálculo de CO2e sigue siendo 100% del motor propio determinista.
# Dejar ANTHROPIC_API_KEY vacío desactiva la IA sin tocar ANALISIS_IA.
ANALISIS_IA=true
ANTHROPIC_API_KEY=
ANALISIS_IA_MODELO=claude-sonnet-5
ANALISIS_IA_TIMEOUT_MS=15000
# Referenciales para el costo estimado del panel de admin — ajustar según
# la tarifa vigente de Anthropic (no son una cotización real).
ANALISIS_IA_COSTO_INPUT_CLP_1K=3
ANALISIS_IA_COSTO_OUTPUT_CLP_1K=15

# --- Seguridad / JWT ---
# Genera secretos largos y aleatorios: `openssl rand -hex 48`
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Correo (Resend) ---
RESEND_API_KEY=
MAIL_FROM="sicr3p <no-responder@sicrep.cl>"
# Si no hay RESEND_API_KEY, los correos se registran en consola (modo dev).

# --- Datos de demostración ---
# true = el seed inserta clientes/prospectos ficticios (solo entornos de prueba).
# En producción déjalo en false (o sin definir).
SEED_DEMO=false

# --- Admin inicial (usado por `npm run seed`) ---
ADMIN_EMAIL=admin@sicrep.cl
# Si se deja vacío, el seed genera una contraseña segura y la imprime.
ADMIN_PASSWORD=

# --- BaseAPI (situación tributaria del SII por RUT, opcional) ---
# Autocompletado de formularios con datos PÚBLICOS del SII (razón
# social, actividades) — sin BASEAPI_API_KEY el módulo queda apagado
# (503 limpio, sin romper nada). Este uso NUNCA requiere la clave
# tributaria de nadie (es un dato público por RUT).
BASEAPI_API_KEY=
BASEAPI_BASE=https://api.baseapi.cl/api/v1
BASEAPI_TIMEOUT_MS=15000

# --- Descarga del RCV/DTE del SII (contabilidad de carbono, opcional) ---
# Acá SÍ se usa la clave tributaria del contribuyente, siempre por
# request desde su propio panel; se persiste cifrada (AES-256-GCM) solo
# si la empresa opta explícitamente por guardarla, nunca en texto plano.
# Proveedor intercambiable, sin tocar rutas ni el cálculo:
#   'baseapi'    (por defecto; trae el XML del DTE recibido → método
#                 físico en compras) — reutiliza BASEAPI_API_KEY de arriba.
#   'simpleapi'  (RCV sin detalle de ítems → compras por gasto)
#   'apigateway' (ídem simpleapi; pasarela directa al RCV del SII)
SII_PROVEEDOR=baseapi
SIMPLEAPI_KEY=
SIMPLEAPI_BASE=https://servicios.simpleapi.cl/api
SIMPLEAPI_TIMEOUT_MS=20000
APIGATEWAY_API_KEY=
APIGATEWAY_BASE=https://app.apigateway.cl/api/v2
APIGATEWAY_TIMEOUT_MS=20000

# --- BigQuery (data warehouse, opcional) ---
# Todo lo escaneado se exporta al dataset cuando BIGQUERY_EXPORT=true.
# Requiere una cuenta de servicio GCP con rol "BigQuery Data Editor".
# El esquema del dataset está en backend/bigquery/schema.sql.
BIGQUERY_EXPORT=false
BQ_PROJECT_ID=
BQ_DATASET=sicr3p
# Ruta al JSON de la cuenta de servicio (NUNCA commitearlo)
BQ_KEY_FILE=
